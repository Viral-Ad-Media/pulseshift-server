NODE_ENV=production
PORT=4000
# Neon pooled URL for request traffic; direct URL for migration/import scripts.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000
GEMINI_API_KEY=
TRUST_PROXY_HOPS=

# Optional account recovery and billing integrations (never put these in VITE variables).
FRONTEND_URL=http://localhost:3000
RESEND_API_KEY=
MAIL_FROM=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TEAM_PRICE_ID=
STRIPE_BUSINESS_PRICE_ID=
# Local isolated mode ignores external service credentials unless explicitly enabled.
LOCAL_EXTERNAL_SERVICES=0
